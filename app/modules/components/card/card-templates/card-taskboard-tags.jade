//- Keep the original tag colors; bound the row without dropping extra tags.
.card-tags.taskboard-tags(ng-if="(vm.taskboardStory || vm.taskboardTask || vm.kanbanStory) && vm.visible('tags') && vm.item.get('colorized_tags').size")
    span.card-tag(
        ng-if="$index < 3"
        tg-repeat="tag in vm.item.get('colorized_tags') track by tag.get('name')"
        ng-style="{'background-color': vm.getTagColor(tag.get('color'))}"
        ng-attr-title="{{ tag.get('name') }}"
    ) {{ tag.get('name') }}
    button.card-overflow-button(
        type="button"
        ng-if="vm.item.get('colorized_tags').size > 3"
        ng-click="vm.showTaskboardTags = !vm.showTaskboardTags; $event.stopPropagation()"
        ng-attr-aria-expanded="{{ !!vm.showTaskboardTags }}"
        aria-label="{{ 'COMMON.FILTERS.CATEGORIES.TAGS' | translate }}"
    ) +{{ vm.item.get('colorized_tags').size - 3 }}
    .card-collection-popover(
        ng-if="vm.showTaskboardTags"
        ng-click="$event.stopPropagation()"
    )
        span.card-tag(
            tg-repeat="tag in vm.item.get('colorized_tags') track by tag.get('name')"
            ng-style="{'background-color': vm.getTagColor(tag.get('color'))}"
        ) {{ tag.get('name') }}
