header
    h1.title(translate="WIKI.NAVIGATION.SECTION_NAME")

ul.wiki-link-container
    li.wiki-link.fixed-link(ng-class="{'has-chapters': wikiOutline.home.length}")
        button.wiki-section-toggle(type="button" ng-if="wikiOutline.home.length" ng-click="wikiChaptersOpen.home = !wikiChaptersOpen.home" ng-attr-aria-expanded="{{!!wikiChaptersOpen.home}}" aria-label="Toggle Main Page chapters")
            tg-svg(svg-icon="icon-arrow-right" ng-class="{'is-open': wikiChaptersOpen.home}")
        a.link-title(
            href=""
            tg-nav="project-wiki:project=project.slug"
            translate="WIKI.NAVIGATION.HOME"
        )
        ul.wiki-chapter-list(ng-if="wikiChaptersOpen.home && wikiOutline.home.length")
            li(ng-repeat="chapter in wikiOutline.home track by chapter.id" ng-class="{'is-subchapter': chapter.level == 2}")
                a.wiki-chapter-link(ng-href="/project/{{projectSlug}}/wiki/home#{{chapter.id}}" ng-class="{active: activeWikiChapter == chapter.id}" ng-bind="chapter.title")


ul.sortable.wiki-link-container
    li.wiki-link.e2e-wiki-page-link(
        ng-repeat="link in wikiLinks"
        data-id!="{{ $index }}"
        tg-bind-scope
        tg-class-permission="{'is-sortable': 'add_wiki_link'}"
        ng-class="{'active': wiki.slug == link.href, 'has-chapters': wikiOutline[link.href].length}"
    )
        <% if (addWikiLinkPermission) { %>
        tg-svg.dragger(svg-icon="icon-drag")
        <% } %>
        button.wiki-section-toggle(type="button" ng-if="wikiOutline[link.href].length" ng-click="wikiChaptersOpen[link.href] = !wikiChaptersOpen[link.href]" ng-attr-aria-expanded="{{!!wikiChaptersOpen[link.href]}}" aria-label="Toggle section chapters")
            tg-svg(svg-icon="icon-arrow-right" ng-class="{'is-open': wikiChaptersOpen[link.href]}")
        a.link-title(title!="{{ link.title }}", href!="{{ link.url }}") {{ link.title }}

        <% if (deleteWikiLinkPermission) { %>
        a.js-delete-link.remove-wiki-page(title!="{{'WIKI.DELETE_LINK_TITLE' | translate}}")
            tg-svg(svg-icon="icon-trash")
        <% } %>

        ul.wiki-chapter-list(ng-if="wikiChaptersOpen[link.href] && wikiOutline[link.href].length")
            li(ng-repeat="chapter in wikiOutline[link.href] track by chapter.id" ng-class="{'is-subchapter': chapter.level == 2}")
                a.wiki-chapter-link(ng-href="{{link.url}}#{{chapter.id}}" ng-class="{active: activeWikiChapter == chapter.id}" ng-bind="chapter.title")

        input.hidden(
            type="text"
            placeholder="{{'COMMON.FIELDS.NAME' | translate}}"
            value!="{{ link.title }}"
        )

ul.sortable.wiki-link-container
    li.new.hidden
        input(
            type="text"
            placeholder="{{'COMMON.FIELDS.NAME' | translate}}"
        )

<% if (addWikiLinkPermission) { %>
a.add-button(
    href=""
    title="{{'WIKI.NAVIGATION.ACTION_ADD_LINK' | translate}}"
)
    .button-primary.button-small
        tg-svg(svg-icon="icon-add")
    span(translate="WIKI.NAVIGATION.ACTION_ADD_LINK")
<% } %>

ul.wiki-link-container.wiki-all-links(ng-if="wikiLinks.length")
    li.wiki-link.fixed-link
        a.link-title.secondary(
            href=""
            tg-nav="project-wiki-list:project=project.slug"
            translate="WIKI.NAVIGATION.ALL_PAGES"
        )

p.wiki-outline-help Use Heading 1 for chapters and Heading 2 for subchapters.
p.wiki-outline-error(ng-if="wikiOutlineError") The chapter index could not be loaded. Reload to try again.
