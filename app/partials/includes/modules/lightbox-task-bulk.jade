tg-lightbox-close
form
    .bulk-task-header.bulk-status-selector-wrapper
        h2.title(translate="COMMON.NEW_BULK")
        button.btn-icon.compact-add-user.bulk-assign-button(type="button" ng-click="assignBulkTasks()" title="{{'COMMON.ASSIGNED_USERS.ADD_ASSIGNED' | translate}}" aria-label="{{'COMMON.ASSIGNED_USERS.ADD_ASSIGNED' | translate}}")
            tg-svg(svg-icon="icon-user-plus")
            span(ng-if="form.assignedUsers.length") {{form.assignedUsers.length}}
    fieldset
        textarea(
            cols="200"
            wrap="off"
            ng-model="form.data"
            data-required="true"
            data-linewidth="200"
            ng-attr-placeholder="{{'COMMON.ONE_ITEM_LINE' | translate}}"

        )

    button.btn-big(
        type="submit"
        title="{{'COMMON.SAVE' | translate}}"
        translate="COMMON.SAVE"
    )
