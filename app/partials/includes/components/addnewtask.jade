//- Preserve the existing task creation handlers and permissions.
button.add-action.btn-board(
    type="button"
    tg-check-permission="add_task"
    title="{{'TASKBOARD.TITLE_ACTION_ADD' | translate}}"
    aria-label="{{'TASKBOARD.TITLE_ACTION_ADD' | translate}}"
    ng-click="ctrl.addNewTask('standard', us)"
)
    tg-svg(svg-icon="icon-story-plus")

button.bulk-action.btn-board(
    type="button"
    title="{{'TASKBOARD.TITLE_ACTION_ADD_BULK' | translate}}"
    aria-label="{{'TASKBOARD.TITLE_ACTION_ADD_BULK' | translate}}"
    ng-click="ctrl.addNewTask('bulk', us)"
    tg-check-permission="add_task"
)
    tg-svg(svg-icon="icon-story-list-plus")
